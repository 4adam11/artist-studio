# Copy this file to server/.env and fill in what you need.
# Everything is optional: with no .env the site runs with sample data,
# no admin page, no online payments and no email.

# Port the API listens on. If you change it, start the client with
# API_TARGET=http://localhost:<port> so the dev proxy can find it.
PORT=5050

# Where db.json and uploaded images are stored (relative to server/).
DATA_DIR=data

# Password for the /admin page. Leave empty to disable the admin area.
ADMIN_PASSWORD=

# Public address of the site, used for Stripe's return links.
# In development this is the Vite dev server.
PUBLIC_URL=http://localhost:5173

# Only needed if the frontend is hosted on a different domain than the API,
# e.g. CORS_ORIGIN=https://studio.example.com
CORS_ORIGIN=

# Set to true when running behind a reverse proxy (Render, Railway, nginx...)
# so rate limiting sees the visitor's real IP address.
TRUST_PROXY=false

# --- Online payments (Stripe Checkout) ---
# Get a key from https://dashboard.stripe.com/apikeys (use sk_test_... while testing).
# Without it, the checkout takes orders and you invoice buyers yourself.
STRIPE_SECRET_KEY=
CURRENCY=usd

# --- Email notifications for new messages and orders ---
NOTIFY_EMAIL=
FROM_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
